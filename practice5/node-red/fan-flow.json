  {
    "id": "sw_fan",
    "type": "switch",
    "z": "tab_sensors",
    "name": "TEMP-01 > 30 ?",
    "property": "payload.value",
    "propertyType": "msg",
    "rules": [
      {
        "t": "gt",
        "v": "30",
        "vt": "num"
      },
      {
        "t": "lte",
        "v": "30",
        "vt": "num"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
