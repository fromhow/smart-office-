[
  {
    "id": "tab_sensors",
    "type": "tab",
    "label": "Датчики и вентилятор",
    "disabled": false,
    "info": ""
  },
  {
    "id": "inj_temp",
    "type": "inject",
    "z": "tab_sensors",
    "name": "TEMP-01 каждые 5 с",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": "2",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 170,
    "y": 80,
    "wires": [
      [
        "chg_temp"
      ]
    ]
  },
  {
    "id": "chg_temp",
    "type": "change",
    "z": "tab_sensors",
    "name": "Показание температуры",
    "rules": [
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "{}",
        "tot": "json"
      },
      {
        "t": "set",
        "p": "payload.sensor_id",
        "pt": "msg",
        "to": "TEMP-01",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "payload.zone",
        "pt": "msg",
        "to": "server_room",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "payload.unit",
        "pt": "msg",
        "to": "C",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "payload.value",
        "pt": "msg",
        "to": "$round($random()*20+20,1)",
        "tot": "jsonata"
      },
      {
        "t": "set",
        "p": "payload.timestamp",
        "pt": "msg",
        "to": "",
        "tot": "date"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 420,
    "y": 80,
    "wires": [
      [
        "http_temp",
        "sw_fan"
      ]
    ]
  },
  {
    "id": "http_temp",
    "type": "http request",
    "z": "tab_sensors",
    "name": "Отправка на CTRL",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://192.168.10.11:8080/api/readings",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 670,
    "y": 80,
    "wires": [
      [
        "dbg_temp"
      ]
    ]
  },
  {
    "id": "dbg_temp",
    "type": "debug",
    "z": "tab_sensors",
    "name": "Ответ TEMP",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 890,
    "y": 80,
    "wires": []
  },
